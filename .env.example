# ============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# MSBioSuper - Java 21 Migration
# ============================================
#
# INSTRUCCIONES:
# 1. Copiar este archivo como .env
# 2. Reemplazar los valores de ejemplo con valores reales
# 3. NO commitear el archivo .env en Git (está en .gitignore)
#
# Para más información sobre configuración JWT:
# Ver JWT-CONFIGURATION.md
#
# ============================================

# ============================================
# BASE DE DATOS POSTGRESQL
# ============================================
# IMPORTANTE: Todas estas variables son OBLIGATORIAS
# La aplicación no iniciará sin ellas

# Servidor de base de datos
JDBC_SERVER=localhost

# Puerto de PostgreSQL (por defecto 5432)
JDBC_PORT=5432

# Nombre de la base de datos
JDBC_DATABASE=cipolliny_Abril_2026

# Usuario de base de datos
JDBC_USER=administradores

# Contraseña de base de datos
# IMPORTANTE: Usar contraseña segura en producción
# Requisitos mínimos:
# - Al menos 12 caracteres
# - Combinación de mayúsculas, minúsculas, números y símbolos
# - No usar contraseñas comunes o predecibles
JDBC_PASSWORD=@dm1n$t0d0c0mPU$

# ============================================
# SEGURIDAD JWT
# ============================================
# IMPORTANTE: Esta variable es OBLIGATORIA
# La aplicación no iniciará sin ella

# Clave secreta para firmar tokens JWT
# REQUISITOS:
# - Mínimo 256 bits (32 bytes)
# - Recomendado 512 bits (64 bytes)
# - Generada con método criptográficamente seguro
#
# GENERAR CLAVE SEGURA:
# Opción 1 (Linux/Mac):
#   openssl rand -base64 64
#
# Opción 2 (Python):
#   python3 scripts/generate-jwt-secret.py
#
# Opción 3 (Bash):
#   bash scripts/generate-jwt-secret.sh
#
# IMPORTANTE: 
# - Usar clave diferente para cada entorno (dev, test, prod)
# - NO usar la clave de ejemplo en producción
# - Rotar claves cada 90 días
# - Mantener backup seguro de claves antiguas para validar tokens existentes
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# Tiempo de expiración del token en milisegundos
# Valores comunes:
# - 3600000 = 1 hora (recomendado para producción)
# - 86400000 = 24 horas (desarrollo)
# - 604800000 = 7 días (aplicaciones móviles)
JWT_EXPIRATION=86400000

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Orígenes permitidos (separados por coma)
# Ejemplos:
# - Desarrollo: http://localhost:3000,http://localhost:4200
# - Producción: https://app.acosux.com,https://admin.acosux.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ============================================
# SERVIDOR
# ============================================
# Puerto del servidor (opcional, por defecto 8080)
SERVER_PORT=8080

# ============================================
# PERFIL DE SPRING BOOT
# ============================================
# Perfil activo: dev, test, prod
# - dev: Desarrollo local con logging detallado
# - test: Pruebas automatizadas
# - prod: Producción con configuración optimizada
SPRING_PROFILES_ACTIVE=dev

# ============================================
# NOTAS DE SEGURIDAD
# ============================================
#
# 1. NUNCA commitear este archivo con valores reales en Git
# 2. Usar gestores de secretos en producción:
#    - HashiCorp Vault
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Google Secret Manager
#
# 3. Limitar acceso a este archivo:
#    chmod 600 .env
#
# 4. Rotar credenciales periódicamente
#
# 5. Auditar acceso a secretos
#
# ============================================
