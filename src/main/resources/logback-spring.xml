<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- ============================================ -->
    <!-- CONFIGURACIÓN DE LOGBACK CON JSON ENCODER   -->
    <!-- ============================================ -->
    <!-- Este archivo configura Logback para generar logs estructurados en formato JSON -->
    <!-- utilizando logstash-logback-encoder para facilitar la agregación de logs -->
    <!-- en sistemas como ELK Stack, Splunk, o servicios de logging en la nube -->

    <!-- Importar configuración base de Spring Boot -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- ============================================ -->
    <!-- PROPIEDADES DE CONFIGURACIÓN                -->
    <!-- ============================================ -->
    
    <!-- Nombre de la aplicación -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="msbiosuper"/>
    
    <!-- Perfil activo (dev, test, prod) -->
    <springProperty scope="context" name="ACTIVE_PROFILE" source="spring.profiles.active" defaultValue="default"/>
    
    <!-- Directorio de logs (configurable mediante variable de entorno) -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    
    <!-- Patrón de nombre de archivo de log -->
    <property name="LOG_FILE" value="${LOG_PATH}/msbiosuper.log"/>

    <!-- ============================================ -->
    <!-- APPENDER DE CONSOLA CON FORMATO JSON        -->
    <!-- ============================================ -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Nombre de la aplicación en los logs -->
            <customFields>{"application":"${APP_NAME}","environment":"${ACTIVE_PROFILE}"}</customFields>
            
            <!-- Incluir nombre del caller (clase y método) -->
            <includeCallerData>true</includeCallerData>
            
            <!-- Incluir contexto (MDC - Mapped Diagnostic Context) -->
            <!-- IMPORTANTE: Esto incluye el correlationId automáticamente -->
            <includeMdc>true</includeMdc>
            
            <!-- Incluir tags -->
            <includeTags>true</includeTags>
            
            <!-- Formato de timestamp ISO 8601 -->
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            
            <!-- Configuración de campos personalizados -->
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <stackTrace>exception</stackTrace>
                <!-- El correlationId se incluye automáticamente desde el MDC -->
                <mdc>mdc</mdc>
            </fieldNames>
            
            <!-- Incluir stack trace completo para excepciones -->
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>4096</maxLength>
                <shortenedClassNameLength>30</shortenedClassNameLength>
                <exclude>sun\.reflect\..*</exclude>
                <exclude>java\.lang\.reflect\..*</exclude>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- APPENDER DE ARCHIVO CON FORMATO JSON        -->
    <!-- ============================================ -->
    <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        
        <!-- Política de rotación de archivos -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Patrón de nombre de archivo rotado -->
            <fileNamePattern>${LOG_PATH}/msbiosuper-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            
            <!-- Tamaño máximo de cada archivo (10MB) -->
            <maxFileSize>10MB</maxFileSize>
            
            <!-- Mantener logs de los últimos 30 días -->
            <maxHistory>30</maxHistory>
            
            <!-- Tamaño total máximo de todos los archivos de log (1GB) -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        
        <!-- Encoder JSON para archivo -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"application":"${APP_NAME}","environment":"${ACTIVE_PROFILE}"}</customFields>
            <includeCallerData>true</includeCallerData>
            <!-- IMPORTANTE: Esto incluye el correlationId automáticamente -->
            <includeMdc>true</includeMdc>
            <includeTags>true</includeTags>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <stackTrace>exception</stackTrace>
                <!-- El correlationId se incluye automáticamente desde el MDC -->
                <mdc>mdc</mdc>
            </fieldNames>
            
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>4096</maxLength>
                <shortenedClassNameLength>30</shortenedClassNameLength>
                <exclude>sun\.reflect\..*</exclude>
                <exclude>java\.lang\.reflect\..*</exclude>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- APPENDER DE CONSOLA CON FORMATO LEGIBLE     -->
    <!-- (Para desarrollo local)                     -->
    <!-- ============================================ -->
    <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Incluir correlationId en el formato legible -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-NO-CORRELATION-ID}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- CONFIGURACIÓN DE NIVELES DE LOG POR PAQUETE -->
    <!-- ============================================ -->
    
    <!-- ========================================== -->
    <!-- LOGS DE LA APLICACIÓN MSBIOSUPER          -->
    <!-- ========================================== -->
    
    <!-- Nivel de log general para la aplicación MSBioSuper -->
    <logger name="com.acosux.MSBiosuper" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para la capa de dominio (lógica de negocio) -->
    <logger name="com.acosux.MSBiosuper.domain" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para la capa de aplicación (casos de uso) -->
    <logger name="com.acosux.MSBiosuper.application" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para la capa de infraestructura (controladores, repositorios) -->
    <logger name="com.acosux.MSBiosuper.infrastructure" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para controladores REST (endpoints) -->
    <logger name="com.acosux.MSBiosuper.infrastructure.rest" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para seguridad (autenticación, autorización) -->
    <logger name="com.acosux.MSBiosuper.infrastructure.security" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para configuración de la aplicación -->
    <logger name="com.acosux.MSBiosuper.infrastructure.config" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- ========================================== -->
    <!-- LOGS DE SPRING FRAMEWORK                  -->
    <!-- ========================================== -->
    
    <!-- Nivel de log general para Spring Framework -->
    <logger name="org.springframework" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring Boot (arranque y configuración) -->
    <logger name="org.springframework.boot" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring Web (controladores, filtros, interceptores) -->
    <logger name="org.springframework.web" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring MVC (mapeo de requests, handlers) -->
    <logger name="org.springframework.web.servlet.mvc" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring Security (autenticación, autorización) -->
    <logger name="org.springframework.security" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring Security Web (filtros de seguridad) -->
    <logger name="org.springframework.security.web" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring Data JPA (repositorios) -->
    <logger name="org.springframework.data.jpa" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring Transaction (gestión de transacciones) -->
    <logger name="org.springframework.transaction" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring JDBC (operaciones de base de datos) -->
    <logger name="org.springframework.jdbc" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Spring Context (contexto de aplicación, beans) -->
    <logger name="org.springframework.context" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- ========================================== -->
    <!-- LOGS DE HIBERNATE                         -->
    <!-- ========================================== -->
    
    <!-- Nivel de log general para Hibernate -->
    <logger name="org.hibernate" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para SQL generado por Hibernate -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para valores de parámetros SQL (binding) -->
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para valores extraídos de SQL (extraction) -->
    <logger name="org.hibernate.type.descriptor.sql.BasicExtractor" level="TRACE" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para gestión de transacciones de Hibernate -->
    <logger name="org.hibernate.engine.transaction.internal.TransactionImpl" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para caché de Hibernate -->
    <logger name="org.hibernate.cache" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para estadísticas de Hibernate -->
    <logger name="org.hibernate.stat" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para motor de Hibernate (interno) -->
    <logger name="org.hibernate.engine" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- ========================================== -->
    <!-- LOGS DE HIKARICP (POOL DE CONEXIONES)     -->
    <!-- ========================================== -->
    
    <!-- Nivel de log general para HikariCP -->
    <logger name="com.zaxxer.hikari" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para configuración de HikariCP -->
    <logger name="com.zaxxer.hikari.HikariConfig" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para pool de HikariCP -->
    <logger name="com.zaxxer.hikari.pool" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para detección de fugas de HikariCP -->
    <logger name="com.zaxxer.hikari.pool.ProxyLeakTask" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- ========================================== -->
    <!-- LOGS DE OTRAS LIBRERÍAS                   -->
    <!-- ========================================== -->
    
    <!-- Nivel de log para driver PostgreSQL -->
    <logger name="org.postgresql" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Jackson (serialización JSON) -->
    <logger name="com.fasterxml.jackson" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Tomcat embebido -->
    <logger name="org.apache.catalina" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Tomcat Coyote (conector HTTP) -->
    <logger name="org.apache.coyote" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para SpringDoc OpenAPI -->
    <logger name="org.springdoc" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Micrometer (métricas) -->
    <logger name="io.micrometer" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>
    
    <!-- Nivel de log para Actuator -->
    <logger name="org.springframework.boot.actuate" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>

    <!-- ============================================ -->
    <!-- CONFIGURACIÓN POR PERFIL (PROFILE)          -->
    <!-- ============================================ -->
    
    <!-- Perfil de DESARROLLO (dev) -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE_PLAIN"/>
        </root>
        
        <!-- En desarrollo, usar formato legible en consola -->
        <logger name="com.acosux.MSBiosuper" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE_PLAIN"/>
        </logger>
    </springProfile>
    
    <!-- Perfil de PRUEBAS (test) -->
    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
        
        <logger name="com.acosux.MSBiosuper" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE_JSON"/>
        </logger>
    </springProfile>
    
    <!-- Perfil de PRODUCCIÓN (prod) -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
        </root>
        
        <logger name="com.acosux.MSBiosuper" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
        </logger>
        
        <!-- En producción, reducir logs de frameworks -->
        <logger name="org.springframework" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
        </logger>
        
        <logger name="org.hibernate" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
        </logger>
    </springProfile>

    <!-- ============================================ -->
    <!-- CONFIGURACIÓN ROOT (Por defecto)            -->
    <!-- ============================================ -->
    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </root>

</configuration>
