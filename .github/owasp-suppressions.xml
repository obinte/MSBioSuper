<?xml version="1.0" encoding="UTF-8"?>
<!--
  Archivo de supresiones para OWASP Dependency Check
  
  Este archivo contiene supresiones para falsos positivos conocidos
  en el análisis de vulnerabilidades de dependencias.
  
  Autor: Josias Rubén Aldaz Arcalles
  Fecha: 2026-04-24
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    
    <!-- ============================================ -->
    <!-- SUPRESIONES GENERALES                       -->
    <!-- ============================================ -->
    
    <!-- Suprimir vulnerabilidades de desarrollo/test que no afectan producción -->
    <suppress>
        <notes><![CDATA[
            Vulnerabilidades en dependencias de test que no se incluyen en el JAR final
        ]]></notes>
        <gav regex="true">.*:.*:.*</gav>
        <cpe>cpe:/a:junit:junit</cpe>
        <cve>CVE-2020-15250</cve>
    </suppress>
    
    <!-- Suprimir vulnerabilidades conocidas de Spring Boot que ya están parcheadas -->
    <suppress>
        <notes><![CDATA[
            Spring Boot 3.3.5 ya incluye parches para vulnerabilidades conocidas
        ]]></notes>
        <gav regex="true">org\.springframework\.boot:.*:3\.3\.5</gav>
        <cve>CVE-2023-20873</cve>
    </suppress>
    
    <!-- ============================================ -->
    <!-- SUPRESIONES ESPECÍFICAS DEL PROYECTO        -->
    <!-- ============================================ -->
    
    <!-- Suprimir vulnerabilidades de Apache POI (versión antigua requerida por el negocio) -->
    <suppress>
        <notes><![CDATA[
            Apache POI 3.13-beta1 es requerido por compatibilidad con formatos Excel específicos.
            Se evaluará actualización en futuras versiones.
        ]]></notes>
        <gav>org.apache.poi:poi:3.13-beta1</gav>
        <cve>CVE-2019-12415</cve>
        <cve>CVE-2019-12411</cve>
    </suppress>
    
    <!-- Suprimir falsos positivos de PostgreSQL driver -->
    <suppress>
        <notes><![CDATA[
            PostgreSQL driver 42.7.4 es la versión más reciente y segura
        ]]></notes>
        <gav>org.postgresql:postgresql:42.7.4</gav>
        <cve>CVE-2022-31197</cve>
    </suppress>
    
    <!-- ============================================ -->
    <!-- SUPRESIONES TEMPORALES                      -->
    <!-- ============================================ -->
    
    <!-- Suprimir vulnerabilidades menores hasta la próxima actualización -->
    <suppress until="2026-06-01Z">
        <notes><![CDATA[
            Vulnerabilidades menores que serán revisadas en la próxima actualización de dependencias
        ]]></notes>
        <cvssBelow>4.0</cvssBelow>
    </suppress>
    
</suppressions>